/Llvm/
# This .gitignore file should be placed at the root of your Unity project
# and use a .gitignore pattern that ignores unwanted files generated by Unity.
# If you are using Git LFS, uncomment the relevant lines below.

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# Visual Studio generated files
.vscode/
.vs/
*.csproj
*.unityproj
*.sln
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.VC.VC.opendb

# Rider generated files
.idea/
*.iml

# OS generated files
.DS_Store
Thumbs.db

# Crash reports
sysinfo.txt

# Asset meta files (optional, keep if you want them in git)
# *.meta

# Packages lock (optional)
# Packages/packages-lock.json

# Unity lock file
ProjectSettings/ProjectVersion.txt

# Temporary editor files
*.dwlt
*.pidb
*.pid
*.tmp

# Blender or other imported art caches
*.blend1
*.blend2

# Zip or archive files
*.zip
*.rar
*.tar
*.gz
